{
  "_comment": "Baseline de seguridad para Claude Code en un proyecto externo. FUSIONAR con el settings.json del proyecto (no pisar): copiar el bloque permissions.deny y el hook PreToolUse. Ver README.md.",
  "permissions": {
    "deny": [
      "Read(../**)",
      "Edit(../**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/credentials.json)"
    ],
    "ask": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/security-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
